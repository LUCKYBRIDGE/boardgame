{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "original_animal_card.schema.json",
  "title": "PLIX Animal-gorithm Original Animal Card Localization",
  "type": "object",
  "required": ["id", "nameEn", "nameKo", "sourcePage", "sourceSlot"],
  "properties": {
    "id": {"type":"string","pattern":"^[a-z0-9_]+$"},
    "nameEn": {"type":"string","minLength":1},
    "nameKo": {"type":"string","minLength":1},
    "sourcePage": {"type":"integer","minimum":1,"maximum":6},
    "sourceSlot": {"type":"integer","minimum":1,"maximum":8}
  },
  "additionalProperties": false
}
