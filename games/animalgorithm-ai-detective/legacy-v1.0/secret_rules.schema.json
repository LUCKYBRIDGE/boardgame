{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "secret_rules.schema.json",
  "title": "Secret Rule",
  "type": "object",
  "required": [
    "id",
    "difficulty",
    "labelKo",
    "logic",
    "conditions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^rule_l[1-3]_[0-9]{2}$"
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "labelKo": {
      "type": "string",
      "minLength": 1
    },
    "logic": {
      "type": "string",
      "enum": [
        "AND",
        "OR"
      ]
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "feature",
          "operator",
          "value"
        ],
        "properties": {
          "feature": {
            "type": "string",
            "enum": [
              "wings",
              "legCount",
              "habitat",
              "bodyCover",
              "size",
              "diet",
              "vertebrate",
              "warmBlooded"
            ]
          },
          "operator": {
            "type": "string",
            "enum": [
              "eq",
              "neq",
              "contains",
              "in",
              "gte",
              "lte"
            ]
          },
          "value": {}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}